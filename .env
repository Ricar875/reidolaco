# --- Meta / Instagram ---
VERIFY_TOKEN=reidolaco-troque-por-uma-senha
APP_SECRET=cole_o_app_secret_do_app_da_meta
IG_TOKEN=cole_o_token_de_acesso_da_conta_do_instagram

# --- Impressora (escolha UM modo) ---
# windows = impressora USB compartilhada no Windows (nome do compartilhamento abaixo)
# network = impressora com cabo de rede (IP)   | file = grava em arquivo (testes / Linux /dev/usb/lp0)
PRINT_MODE=windows
PRINTER_SHARE=MP4200
PRINTER_IP=192.168.0.50
PRINTER_PORT=9100
PRINT_FILE=print.bin

PORT=3000
# DRY_RUN=1  (não envia mensagens ao Instagram; só mostra no terminal)
